    "/api/geocercas/verificar": {
      "post": {
        "tags": [
          "Geocercas"
        ],
        "description": "Endpoint lógico para el ESP32. Verifica si la coordenada actual está dentro de alguna geocerca y genera alertas.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "dispositivo_id": {
                  "type": "string",
                  "example": "a1b2c3d4..."
                },
                "lat": {
                  "type": "string",
                  "example": "19.4326 N"
                },
                "lng": {
