    "/api/geocercas/": {
      "post": {
        "tags": [
          "Geocercas"
        ],
        "description": "Crea una nueva zona segura (polígono) para un paciente.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "pacienteId": {
                  "type": "string",
                  "example": "645..."
                },
                "nombre": {
                  "type": "string",
                  "example": "Casa"
                },
                "coords": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "example": [
                      19.4325,
                      -99.133
                    ],
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Geocerca creada"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Datos inválidos (mínimo 3 puntos)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
