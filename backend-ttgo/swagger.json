        "responses": {
          "200": {
            "description": "Correo enviado (si existe el usuario)"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/cuidadores/reset-password": {
      "post": {
        "tags": [
          "Autenticación y manejo del cuidador"
        ],
        "description": "Establece una nueva contraseña usando el token recibido por correo.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "eyJ..."
                },
                "password": {
                  "type": "string",
                  "example": "NewPassw0rd*"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contraseña actualizada"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Token inválido"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
