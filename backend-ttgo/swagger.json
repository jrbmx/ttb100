    "/api/pacientes/{id}/ubicacion": {
      "get": {
        "tags": [
          "Pacientes"
        ],
        "description": "Obtiene la última ubicación conocida (lat/long) de un paciente específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Ubicación encontrada",
            "schema": {
              "type": "object",
              "properties": {
                "latitud": {
                  "type": "number",
                  "example": 19.4326
                },
                "longitud": {
                  "type": "number",
                  "example": -99.1332
                },
                "fecha": {
                  "type": "string",
                  "example": "2025-05-26T10:00:00.000Z"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Paciente no encontrado o sin datos de ubicación"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
