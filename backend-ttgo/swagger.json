{
  "swagger": "2.0",
  "info": {
    "title": "Overvak - Sistema de monitoreo remoto para personas con Alzheimer a través de un wearable.",
    "description": "Documentación oficial de la API RESTful para el ecosistema **Overvak**. \n\nEste backend gestiona la comunicación entre los dispositivos wearables y la aplicación web. \n\n**Módulos del sistema:**\n1. **Autenticación:** Gestión de cuidadores y tokens.\n2. **Pacientes:** Vinculación de dispositivos y perfiles.\n3. **Datos IoT:** Ingesta de sensores, tales como el MAX30102, GPS (NEO6MV2) y acelerómetro.\n4. **Geocercas:** Algoritmos de punto en polígono para zonas seguras.\n5. **Alertas:** Notificaciones de emergencia.",
    "version": "1.2.1"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Introduce tu token así: Bearer <tu_token>"
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/datos/": {
      "post": {
        "tags": [
          "Datos del paciente"
        ],
        "description": "Recibe datos del sensor. Verifica umbrales y genera alertas automáticas de caídas, inactividad o sensor desconectado.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "dispositivo_id": {
                  "type": "string",
                  "example": "a1b2c3d4-1678886400"
                },
                "frecuencia": {
                  "type": "number",
                  "example": 85
                },
                "oxigeno": {
                  "type": "number",
                  "example": 98
                },
                "latitud": {
                  "type": "number",
                  "example": 19.4326
                },
                "longitud": {
                  "type": "number",
                  "example": -99.1322
                },
                "contacto_cardiaco": {
                  "type": "boolean",
                  "example": true
                },
                "caida_detectada": {
                  "type": "boolean",
                  "example": false
                },
                "inactividad_detectada": {
                  "type": "boolean",
                  "example": false
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Dato procesado correctamente",
            "schema": {
              "$ref": "#/definitions/Dato"
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Faltan datos del sensor o ID del dispositivo"
          },
          "404": {
            "description": "Dispositivo no vinculado a un paciente"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/datos/paciente/{pacienteId}": {
      "get": {
        "tags": [
          "Datos del paciente"
        ],
        "description": "Obtiene el historial completo de datos de un paciente específico",
        "parameters": [
          {
            "name": "pacienteId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente (MongoDB ID)"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de datos obtenida"
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Paciente no encontrado o no autorizado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/datos/reciente/{pacienteId}": {
      "get": {
        "tags": [
          "Datos del paciente"
        ],
        "description": "Obtiene únicamente la última lectura registrada del paciente",
        "parameters": [
          {
            "name": "pacienteId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del paciente"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Último dato obtenido"
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sin datos o paciente no encontrado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cuidadores/register": {
      "post": {
        "tags": [
          "Autenticación y manejo del cuidador"
        ],
        "description": "Registro de un nuevo cuidador. Envía correo de verificación.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Alberto"
                },
                "apellidoP": {
                  "type": "string",
                  "example": "Vega"
                },
                "apellidoM": {
                  "type": "string",
                  "example": "Monterrubio"
                },
                "email": {
                  "type": "string",
                  "example": "example@gmail.com"
                },
                "telefono": {
                  "type": "string",
                  "example": "5512345688"
                },
                "password": {
                  "type": "string",
                  "example": "Passw0rd*"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario creado. Correo enviado."
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "El correo ya está registrado"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/cuidadores/verificar/{token}": {
      "get": {
        "tags": [
          "Autenticación y manejo del cuidador"
        ],
        "description": "Endpoint accedido desde el correo para activar la cuenta.",
        "produces": [
          "text/html"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Token JWT enviado por email"
          }
        ],
        "responses": {
          "200": {
            "description": "HTML de confirmación exitosa"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "HTML de error (token inválido)"
          }
        }
      }
    },
    "/api/cuidadores/login": {
      "post": {
        "tags": [
          "Autenticación y manejo del cuidador"
        ],
        "description": "Inicio de sesión. Devuelve Token JWT.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "example": "example@gmail.com"
                },
                "password": {
                  "type": "string",
                  "example": "pass"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login exitoso",
            "schema": {
              "type": "object",
              "properties": {
                "mensaje": {
                  "type": "string",
                  "example": "Inicio de sesión correcto"
                },
                "token": {
                  "type": "string",
                  "example": "eyJhbGciOiJIUzI1NiIsIn..."
                },
                "cuidador": {
                  "type": "object",
                  "properties": {
                    "_id": {
                      "type": "string",
                      "example": "645..."
                    },
                    "nombre": {
                      "type": "string",
                      "example": "Alberto"
                    },
                    "email": {
                      "type": "string",
                      "example": "example@gmail.com"
                    },
                    "verificado": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Credenciales incorrectas"
          },
          "403": {
            "description": "Cuenta no verificada"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/cuidadores/forgot-password": {
      "post": {
        "tags": [
          "Autenticación y manejo del cuidador"
        ],
        "description": "Solicita un correo para restablecer contraseña.",
        "parameters": [
          {
            "name": "body",
