          }
        }
      },
      "delete": {
        "tags": [
          "Autenticación y manejo del cuidador"
        ],
        "description": "Elimina la cuenta del cuidador.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID del cuidador"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/pacientes/": {
      "post": {
        "tags": [
          "Pacientes"
        ],
        "description": "Registrar un nuevo paciente bajo el cuidado del usuario actual.",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nombre": {
                  "type": "string",
                  "example": "Juan"
                },
                "apellidoP": {
                  "type": "string",
                  "example": "Pérez"
                },
                "apellidoM": {
                  "type": "string",
                  "example": "López"
                },
                "edad": {
                  "type": "number",
                  "example": 75
                },
                "dispositivo_id": {
                  "type": "string",
                  "example": "a1b2c3d4-1678886400"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Paciente registrado exitosamente"
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Faltan campos obligatorios"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Conflicto: El ID del dispositivo ya está en uso por otro paciente."
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "tags": [
          "Pacientes"
        ],
